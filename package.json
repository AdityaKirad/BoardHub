{
  "name": "boardhub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/prettier ."
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "bracketSameLine": true,
    "tailwindFunctions": [
      "cn"
    ]
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@base-ui/react": "^1.6.0",
    "@conform-to/react": "^1.19.4",
    "@conform-to/zod": "^1.19.4",
    "@libsql/client": "^0.17.4",
    "@oslojs/crypto": "^1.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fractional-indexing": "^4.0.0",
    "input-otp": "^1.4.2",
    "is-ip": "^5.0.1",
    "isbot": "^5.1.36",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "remix-flat-routes": "^0.8.5",
    "remix-themes": "^2.0.4",
    "remix-utils": "^10.0.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@react-router/dev": "8.0.0",
    "@react-router/remix-routes-option-adapter": "^8.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "msw": "^2.14.6",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-router-devtools": "^6.2.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.3",
    "vite-node": "^6.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
